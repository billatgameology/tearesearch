---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { zhTranslations } from "../data/zh";
import { geoAlbersUsa, geoPath } from "d3-geo";
import { feature, mesh } from "topojson-client";
import statesAtlas from "us-atlas/states-10m.json";
import {
  marketSignals,
  customerNeeds,
  models,
  cities,
  marketDossiers,
  cases,
  leaseGates,
  roadmap
} from "../data/research";

const confidenceLabel = {
  verified: "Verified evidence",
  directional: "Directional analysis",
  illustrative: "Illustrative scenario",
  "not-tested": "Not yet tested"
};

const projection = geoAlbersUsa().scale(1160).translate([480, 292]);
const mapPath = geoPath(projection);
const atlas = statesAtlas as any;
const nationPath = mapPath(feature(atlas, atlas.objects.nation) as any) || "";
const statePath = mapPath(mesh(atlas, atlas.objects.states, (a, b) => a !== b) as any) || "";
const cityMapPoints = cities.map((city) => {
  const point = projection(city.coordinates as [number, number]) || [0, 0];
  return { ...city, x: point[0], y: point[1] };
});

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const publicUrl = (path: string) => `${baseUrl}${path.replace(/^\/+/, "")}`;
---

<BaseLayout
  title="Chinese Tea in America — Research Atlas"
  description="An evidence-led study of demand, business models, cities, economics and the path to validation for a Chinese tea business in the United States."
>
  <SiteHeader />

  <main id="top">
    <section class="hero">
      <div class="hero__wash" aria-hidden="true"></div>
      <div class="hero__grid shell">
        <div class="hero__copy">
          <div class="hero__meta">
            <span>Research atlas · 2026</span>
            <span>United States</span>
          </div>
          <p class="eyebrow hero__eyebrow">The central question</p>
          <h1 data-hero-title data-i18n-dynamic>What would it take to build a <em>durable</em> Chinese tea business in America?</h1>
          <p class="hero__dek">
            A study of customer behavior, operating models, cities, unit economics and prior attempts—designed to separate cultural possibility from commercial proof.
          </p>
          <div class="hero__actions">
            <a class="button hero__button" href="#market">Begin with the evidence <span aria-hidden="true">↓</span></a>
            <span class="status status--directional">Decision research, not completed validation</span>
          </div>
        </div>

        <div class="hero__object" aria-hidden="true">
          <div class="steam steam--one"></div>
          <div class="steam steam--two"></div>
          <div class="tea-orbit">
            <span class="tea-orbit__label tea-orbit__label--one">Demand</span>
            <span class="tea-orbit__label tea-orbit__label--two">Economics</span>
            <span class="tea-orbit__label tea-orbit__label--three">Operations</span>
            <div class="tea-bowl"><div class="tea-bowl__surface"></div></div>
          </div>
        </div>

        <div class="hero__ledger" aria-label="Research sequence">
          <span>01 Market</span>
          <span>02 Behavior</span>
          <span>03 Models</span>
          <span>04 Place</span>
          <span>05 Decision</span>
        </div>
      </div>
    </section>

    <section class="legend-strip">
      <div class="shell legend-strip__inner">
        <p>How to read this research</p>
        <div class="legend-strip__items">
          <span class="status status--verified">Verified</span>
          <span class="status status--directional">Directional</span>
          <span class="status status--illustrative">Illustrative</span>
          <span class="status status--not-tested">Not tested</span>
        </div>
      </div>
    </section>

    <section class="chapter market" id="market">
      <div class="shell">
        <header class="section-heading reveal">
          <span class="section-index">01 / MARKET REALITY</span>
          <p class="eyebrow">Begin with what the data can support</p>
          <h2>Tea is familiar. This proposition is not.</h2>
          <p>
            Broad category awareness lowers one barrier, but it does not prove demand for gongfu-style experiences, unsweetened loose leaf, premium teaware or repeat specialist purchasing.
          </p>
        </header>

        <div class="signal-grid">
          {marketSignals.map((signal, index) => (
            <article class="signal-card reveal" style={`--delay:${index * 80}ms`}>
              <span class={`status status--${signal.confidence}`}>{confidenceLabel[signal.confidence]}</span>
              <strong>{signal.value}</strong>
              <h3>{signal.label}</h3>
              <p>{signal.detail}</p>
            </article>
          ))}
        </div>

        <div class="proof-grid">
          <article class="proof-card proof-card--positive reveal">
            <p class="proof-card__label">The desk research supports</p>
            <ul>
              <li>Tea is already a mainstream U.S. category.</li>
              <li>Specialist experiences sell in multiple cities.</li>
              <li>Customers pay for tastings, memberships, leaves and teaware.</li>
              <li>Tea can function as culture, community and an alcohol-free occasion.</li>
            </ul>
          </article>
          <article class="proof-card proof-card--open reveal">
            <p class="proof-card__label">The market has not yet proven</p>
            <ul>
              <li>That viewers of tea education become buyers.</li>
              <li>That boba customers become unsweetened loose-leaf customers.</li>
              <li>That a trained manager can reproduce a founder-led experience.</li>
              <li>That any one neighborhood supports permanent rent and labor.</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="chapter customers" id="customers">
      <div class="shell">
        <header class="section-heading reveal">
          <span class="section-index">02 / CUSTOMER BEHAVIOR</span>
          <p class="eyebrow">The real competitive set</p>
          <h2>People do not buy “tea culture” in the abstract.</h2>
          <p>
            They already spend against concrete needs: energy, discovery, craft, gifting, calm and social connection. Chinese tea must win an occasion before it can build a category.
          </p>
        </header>

        <div class="opportunity-intro reveal">
          <span class="status status--directional">Opportunity mapping</span>
          <p>Each opportunity shows the existing spending habit and the specific way Chinese tea could enter it.</p>
        </div>

        <div class="opportunity-grid" role="list">
          {customerNeeds.map((item, index) => (
            <article class="opportunity-card reveal" role="listitem" style={`--delay:${index * 55}ms`}>
              <div class="opportunity-card__top">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <i style={`--signal:${item.signal}%`} aria-hidden="true"></i>
              </div>
              <h3>{item.need}</h3>
              <dl>
                <div><dt>Current spending destination</dt><dd>{item.competesWith}</dd></div>
                <div><dt>Potential entry point</dt><dd>{item.opening}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="chapter models-section" id="models">
      <div class="shell">
        <header class="section-heading reveal">
          <span class="section-index">03 / BUSINESS MODELS</span>
          <p class="eyebrow">Seven ways to enter the market</p>
          <h2>The same mission creates very different businesses.</h2>
          <p>
            Compare each model by evidence speed, capital intensity, flexibility and dependence on a physical operator. The ordering below can be changed without changing the source data.
          </p>
        </header>

        <div class="model-toolbar reveal" role="group" aria-label="Order business models">
          <span>View by</span>
          <button class="is-active" type="button" data-model-view="score" aria-pressed="true">Overall score</button>
          <button type="button" data-model-view="capital" aria-pressed="false">Lowest capital</button>
          <button type="button" data-model-view="flexible" aria-pressed="false">Remote flexibility</button>
          <button type="button" data-model-view="physical" aria-pressed="false">Physical formats</button>
        </div>

        <div class="model-list" data-model-list>
          {models.map((model, index) => (
            <article
              class="model-row reveal"
              data-model-card
              data-score={model.score}
              data-capital={model.capital}
              data-tags={model.tags.join(" ")}
              style={`--delay:${Math.min(index * 55, 240)}ms`}
            >
              <div class="model-row__rank">{String(model.rank).padStart(2, "0")}</div>
              <div class="model-row__main">
                <h3>{model.name}</h3>
                <p>{model.thesis}</p>
              </div>
              <div class="model-row__score">
                <span>Weighted score</span>
                <strong>{model.score.toFixed(2)}</strong>
                <i style={`--score:${model.score / 5 * 100}%`}></i>
              </div>
              <div class="model-row__numbers">
                <span>Startup <b>${Math.round(model.capital / 1000)}K</b></span>
                <span>Fixed / mo <b>${Math.round(model.fixed / 1000)}K</b></span>
              </div>
              <p class="model-row__decision">{model.decision}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="chapter cities-section" id="cities">
      <div class="shell">
        <header class="section-heading reveal">
          <span class="section-index">04 / CITY ANALYSIS</span>
          <p class="eyebrow">A market is not a neighborhood</p>
          <h2>Five cities answer five different questions.</h2>
          <p>
            The scorecard is a screening device, not a site-selection conclusion. Paid behavior must still be tested in distinct neighborhood contexts.
          </p>
        </header>

        <figure class="city-map card reveal" aria-labelledby="city-map-caption">
          <svg class="city-map__graphic" viewBox="0 0 960 585" role="img" aria-labelledby="city-map-title city-map-description">
            <title id="city-map-title">Five U.S. markets in the directional scorecard</title>
            <desc id="city-map-description">A map of the United States labeling Los Angeles, San Francisco, Seattle, Austin and New York.</desc>
            <path class="city-map__nation" d={nationPath} />
            <path class="city-map__states" d={statePath} />
            {cityMapPoints.map((city) => (
              <g class="city-map__marker" transform={`translate(${city.x} ${city.y})`}>
                <circle r="8" />
                <circle class="city-map__marker-ring" r="15" />
                <line x1={city.x > 720 ? -10 : 10} y1="-9" x2={city.x > 720 ? -30 : 30} y2="-24" />
                <text x={city.x > 720 ? -35 : 35} y="-27" text-anchor={city.x > 720 ? "end" : "start"}>{city.name}</text>
                <text class="city-map__score" x={city.x > 720 ? -35 : 35} y="-9" text-anchor={city.x > 720 ? "end" : "start"}>{city.score.toFixed(2)} / 5</text>
              </g>
            ))}
          </svg>
          <figcaption class="city-map__caption" id="city-map-caption">
            <span class="status status--directional">Directional analyst score</span>
            <p>City labels are always visible; the complete reasoning for every market appears below.</p>
          </figcaption>
        </figure>

        <div class="city-card-grid">
          {cities.map((city, index) => (
            <article class="city-card reveal" style={`--delay:${index * 60}ms`}>
              <div class="city-card__top">
                <span>#{city.rank} directional rank</span>
                <strong>{city.score.toFixed(2)}<small>/5</small></strong>
              </div>
              <h3>{city.name}</h3>
              <p class="city-card__role">{city.role}</p>
              <dl>
                <div><dt>Candidate contexts</dt><dd>{city.neighborhoods}</dd></div>
                <div><dt>Why it matters</dt><dd>{city.strength}</dd></div>
                <div><dt>Unresolved tension</dt><dd>{city.tension}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="chapter market-reports-section" id="market-reports">
      <div class="shell">
        <header class="section-heading reveal">
          <span class="section-index">05 / COMPLETED MARKET RESEARCH</span>
          <p class="eyebrow">Five metros, one decision framework</p>
          <h2>The location research is complete enough to compare—not to lease.</h2>
          <p>
            Each report separates observed evidence from inference and scores neighborhoods for three different uses. The scores describe structural fit; they are not sales forecasts or site recommendations.
          </p>
        </header>

        <div class="report-status-grid reveal" aria-label="Market research status">
          <article><strong>5</strong><span>Completed metro reports</span></article>
          <article><strong>5</strong><span>Markets ready for paid tests</span></article>
          <article><strong>0</strong><span>Markets ready for a lease</span></article>
        </div>

        <div class="market-readout reveal">
          <p class="eyebrow">Cross-market readout</p>
          <div class="market-readout__grid">
            {marketDossiers.map((market) => (
              <article>
                <span>{market.code}</span>
                <h3>{market.name}</h3>
                <p>{market.advantage}</p>
                <small>{market.constraint}</small>
              </article>
            ))}
          </div>
        </div>

        <div class="market-dossiers">
          {marketDossiers.map((market, index) => (
            <article class="market-dossier reveal" style={`--delay:${Math.min(index * 70, 210)}ms`}>
              <header class="market-dossier__header">
                <div>
                  <span class="market-dossier__index">{String(index + 1).padStart(2, "0")} / {market.code}</span>
                  <h3>{market.name}</h3>
                </div>
                <span class="status status--verified">{market.status}</span>
              </header>

              <div class="market-dossier__question">
                <p class="eyebrow">The market question</p>
                <h4>{market.question}</h4>
                <p>{market.thesis}</p>
              </div>

              <div class="market-dossier__strategy">
                <dl>
                  <div><dt>Best-fit format</dt><dd>{market.format}</dd></div>
                  <div><dt>Validation lanes</dt><dd>{market.lanes}</dd></div>
                </dl>
                <div class="market-dossier__offers" aria-label={`${market.name} observed price bands`}>
                  {market.offers.map(([label, value]) => (
                    <div><span>{label}</span><strong>{value}</strong></div>
                  ))}
                </div>
              </div>

              <div class="location-scorecard">
                <div class="location-scorecard__heading">
                  <div>
                    <p class="eyebrow">Selected location readout</p>
                    <h4>Different formats produce different winners.</h4>
                  </div>
                  <div class="location-scorecard__legend" aria-label="Score columns">
                    <span><i>C</i> Community</span>
                    <span><i>F</i> Flagship</span>
                    <span><i>B</i> Pop-up / B2B</span>
                  </div>
                </div>
                <div class="location-scorecard__rows">
                  {market.locations.map((location) => (
                    <article>
                      <div><h5>{location.name}</h5><p>{location.use}</p></div>
                      <div class="location-scorecard__scores">
                        <span aria-label={`Community score ${location.community}`}><i>C</i>{location.community.toFixed(1)}</span>
                        <span aria-label={`Flagship score ${location.flagship}`}><i>F</i>{location.flagship.toFixed(1)}</span>
                        <span aria-label={`Pop-up or B2B score ${location.b2b}`}><i>B</i>{location.b2b.toFixed(1)}</span>
                      </div>
                    </article>
                  ))}
                </div>
              </div>

              <footer class="market-dossier__footer">
                <div><span>Next evidence step</span><p>{market.nextMove}</p></div>
                <a href={publicUrl(market.report)} target="_blank" rel="noopener">Read full market report <span aria-hidden="true">↗</span></a>
              </footer>
            </article>
          ))}
        </div>

        <div class="market-pattern reveal">
          <p class="eyebrow">Pattern across all five reports</p>
          <blockquote>Demand should be proved through portable, paid experiences and tracked replenishment before any market is asked to carry permanent occupancy.</blockquote>
        </div>
      </div>
    </section>

    <section class="chapter evidence-section" id="evidence">
      <div class="shell">
        <header class="section-heading reveal">
          <span class="section-index">06 / COMPARABLE EVIDENCE</span>
          <p class="eyebrow">What prior attempts reveal</p>
          <h2>A beloved room can still be a fragile business.</h2>
          <p>
            The most useful cases are not simple winners and failures. They show how durable brands change format while preserving knowledge, community, inventory and customer relationships.
          </p>
        </header>

        <div class="case-timeline">
          {cases.map((item, index) => (
            <article class="case-item reveal" style={`--delay:${Math.min(index * 70, 280)}ms`}>
              <div class="case-item__marker"><span>{String(index + 1).padStart(2,"0")}</span></div>
              <div class="case-item__content">
                <div class="case-item__meta"><span>{item.place}</span><span>{item.outcome}</span></div>
                <h3>{item.company}</h3>
                <p>{item.lesson}</p>
                <div class="case-item__actions">
                  <span class="case-item__mechanism">{item.mechanism.replaceAll("-", " ")}</span>
                  <a href={item.url} target="_blank" rel="noopener noreferrer">Visit source <span aria-hidden="true">↗</span></a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <blockquote class="evidence-quote reveal">
          <p>“The lease should be the result of proven demand—not the tool used to create it.”</p>
          <cite>Pattern synthesized from the comparable-business analysis</cite>
        </blockquote>
      </div>
    </section>

    <section class="chapter economics-section" id="economics">
      <div class="shell">
        <header class="section-heading reveal">
          <span class="section-index">07 / UNIT ECONOMICS</span>
          <p class="eyebrow">The cost of being wrong</p>
          <h2>Rent turns uncertainty into a monthly obligation.</h2>
          <p>
            Use the simulator to see how fixed cost, contribution margin and transaction value translate into operating break-even. These are scenarios—not forecasts.
          </p>
        </header>

        <div class="economics-lab reveal">
          <div class="economics-controls">
            <div class="economics-controls__heading">
              <span class="status status--illustrative">Illustrative model</span>
              <h3>Break-even laboratory</h3>
            </div>
            <label>
              <span>Monthly fixed cost <output data-fixed-output>$12,000</output></span>
              <input data-fixed type="range" min="5000" max="70000" step="1000" value="12000" />
            </label>
            <label>
              <span>Contribution margin <output data-margin-output>55%</output></span>
              <input data-margin type="range" min="30" max="75" step="1" value="55" />
            </label>
            <label>
              <span>Average transaction <output data-ticket-output>$58</output></span>
              <input data-ticket type="range" min="20" max="150" step="2" value="58" />
            </label>
            <div class="scenario-presets" aria-label="Load scenario">
              <button class="is-active" type="button" data-scenario="12000,55,58">Tastings + e-com</button>
              <button type="button" data-scenario="25000,65,72">Studio</button>
              <button type="button" data-scenario="65000,68,26">Tea house</button>
            </div>
          </div>

          <div class="economics-results" aria-live="polite">
            <p>Required operating volume</p>
            <div class="result-primary">
              <span>Monthly break-even revenue</span>
              <strong data-revenue>$21,818</strong>
            </div>
            <div class="result-grid">
              <div><span>Transactions / month</span><strong data-transactions>376</strong></div>
              <div><span>Average / day</span><strong data-daily>13</strong></div>
              <div><span>Target to survive −30%</span><strong data-safe>$31,169</strong></div>
            </div>
            <p class="economics-results__note">Excludes debt service and investor return. Change the inputs; do not mistake precision for certainty.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="chapter synthesis-section" id="synthesis">
      <div class="shell">
        <header class="section-heading reveal">
          <span class="section-index">08 / SYNTHESIS</span>
          <p class="eyebrow">Patterns across the analysis</p>
          <h2>The evidence begins to converge.</h2>
          <p>No single data point decides the strategy. The recommendation follows from the same mechanisms recurring across market behavior, business models, cities, cases and economics.</p>
        </header>

        <div class="synthesis-grid">
          <article class="reveal"><span>01</span><h3>Curiosity is easier than habit.</h3><p>Event excitement matters only when it becomes replenishment, repeat attendance or referral.</p></article>
          <article class="reveal"><span>02</span><h3>Expertise is part of the product.</h3><p>A local operator must reproduce trust, hospitality and cultural interpretation—not just handle a register.</p></article>
          <article class="reveal"><span>03</span><h3>Qualified traffic beats foot traffic.</h3><p>A crowded neighborhood can still supply the wrong customer for a guided specialist offer.</p></article>
          <article class="reveal"><span>04</span><h3>Multiple channels create resilience.</h3><p>Experiences, product, e-commerce, B2B, gifting and membership protect one another.</p></article>
          <article class="reveal"><span>05</span><h3>Physical space amplifies both sides.</h3><p>A room can deepen the brand, but it also magnifies weak demand, labor and inventory decisions.</p></article>
          <article class="reveal"><span>06</span><h3>Proof must precede permanence.</h3><p>Paid behavior produces better evidence than followers, compliments, market-size slides or design ambition.</p></article>
        </div>
      </div>
    </section>

    <section class="recommendation-section" id="recommendation">
      <div class="recommendation-section__ink" aria-hidden="true"></div>
      <div class="shell">
        <div class="recommendation-intro reveal">
          <span class="section-index">09 / RECOMMENDATION</span>
          <p class="eyebrow">After the evidence</p>
          <h2>Build the company before building the tea house.</h2>
          <p>
            Begin as a content-led Chinese tea education and commerce brand, supported by paid tastings, sampler sales, corporate experiences and selective wholesale. Escalate to a compact appointment studio only when repeat local demand and manager-led delivery are visible.
          </p>
        </div>

        <div class="sequence reveal" aria-label="Recommended business sequence">
          {[
            ["01", "Content", "Create curiosity"],
            ["02", "Sampler", "Convert attention"],
            ["03", "Paid events", "Create trust"],
            ["04", "Repeat sales", "Prove habit"],
            ["05", "Small studio", "Serve proven demand"]
          ].map(([number, title, detail]) => (
            <article><span>{number}</span><h3>{title}</h3><p>{detail}</p></article>
          ))}
        </div>

        <div class="recommendation-grid">
          <div class="lease-card reveal">
            <div class="lease-card__heading">
              <p class="eyebrow">Before any lease</p>
              <h3>Evidence gates</h3>
            </div>
            <div class="lease-gates">
              {leaseGates.map(([label, threshold]) => (
                <div><span class="gate-box" aria-hidden="true"></span><p>{label}</p><strong>{threshold}</strong></div>
              ))}
            </div>
          </div>

          <div class="roadmap-card reveal">
            <div class="roadmap-card__heading">
              <p class="eyebrow">First operating cycle</p>
              <h3>90-day validation</h3>
            </div>
            <div class="roadmap">
              {roadmap.map((item, index) => (
                <article>
                  <span>{String(index + 1).padStart(2,"0")}</span>
                  <div><small>{item.period}</small><h4>{item.title}</h4><p>{item.detail}</p></div>
                </article>
              ))}
            </div>
          </div>
        </div>

        <div class="closing-question reveal">
          <p>The final go / no-go question</p>
          <blockquote>Can the company acquire repeat local customers—and can a trained local operator deliver the experience profitably without depending on a permanent storefront?</blockquote>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer" id="research-files">
    <div class="shell site-footer__grid">
      <div>
        <p class="eyebrow">Tea Research Atlas</p>
        <h2>Evidence before real estate.</h2>
      </div>
      <div class="site-footer__links">
        <a href={publicUrl("research/us-chinese-tea-business-report.txt")} target="_blank" rel="noopener">Open research report <span>↗</span></a>
        <a href={publicUrl("research/full-research-transcript.txt")} target="_blank" rel="noopener">Open full research transcript <span>↗</span></a>
        <a href={publicUrl("research/five-market-study.txt")} target="_blank" rel="noopener">Open five-market study <span>↗</span></a>
        <a href={publicUrl("research/comparable-business-cases.txt")} target="_blank" rel="noopener">Open comparable cases <span>↗</span></a>
      </div>
      <div class="site-footer__fineprint">
        <p>Research date: August 2026</p>
        <p>Desk research and illustrative analysis. Not legal, tax, investment or immigration advice.</p>
      </div>
    </div>
  </footer>

  <script is:inline id="tea-translations" type="application/json" set:html={JSON.stringify(zhTranslations)}></script>

  <script>
    const translationElement = document.querySelector<HTMLScriptElement>("#tea-translations");
    const translations: Record<string, string> = translationElement?.textContent
      ? JSON.parse(translationElement.textContent)
      : {};
    const languageToggle = document.querySelector<HTMLButtonElement>("[data-language-toggle]");
    const heroTitle = document.querySelector<HTMLElement>("[data-hero-title]");
    const originalHeroTitle = heroTitle?.innerHTML || "";
    const originalTitle = document.title;
    const descriptionMeta = document.querySelector<HTMLMetaElement>('meta[name="description"]');
    const originalDescription = descriptionMeta?.content || "";
    const staticTextNodes: Array<{ node: Text; english: string }> = [];
    const textWalker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        const parent = node.parentElement;
        if (!parent || !node.nodeValue?.trim()) return NodeFilter.FILTER_REJECT;
        if (parent.closest("script, style, [data-i18n-dynamic]")) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      }
    });
    while (textWalker.nextNode()) {
      const node = textWalker.currentNode as Text;
      staticTextNodes.push({ node, english: node.nodeValue || "" });
    }

    const language = () => document.documentElement.lang === "zh-CN" ? "zh" : "en";

    const applyLanguage = (nextLanguage: "en" | "zh") => {
      document.documentElement.lang = nextLanguage === "zh" ? "zh-CN" : "en";
      staticTextNodes.forEach(({ node, english }) => {
        if (nextLanguage === "en") {
          node.nodeValue = english;
          return;
        }
        const trimmed = english.trim();
        node.nodeValue = translations[trimmed] ? english.replace(trimmed, translations[trimmed]) : english;
      });
      document.title = nextLanguage === "zh" ? (translations[originalTitle] || originalTitle) : originalTitle;
      if (descriptionMeta) descriptionMeta.content = nextLanguage === "zh" ? (translations[originalDescription] || originalDescription) : originalDescription;
      if (heroTitle) {
        heroTitle.innerHTML = nextLanguage === "zh"
          ? '<span class="hero-title-line">在美国打造一个</span><span class="hero-title-line"><em>可持续的</em>中国茶</span><span class="hero-title-line">品牌，需要什么？</span>'
          : originalHeroTitle;
      }
      if (languageToggle) {
        languageToggle.textContent = nextLanguage === "zh" ? "EN" : "中文";
        languageToggle.setAttribute("aria-pressed", String(nextLanguage === "zh"));
        languageToggle.setAttribute("aria-label", nextLanguage === "zh" ? "切换到英文" : "Switch to Chinese");
      }
      try { localStorage.setItem("tea-research-language", nextLanguage); } catch {}
    };

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const reveals = document.querySelectorAll<HTMLElement>(".reveal");
    if (reducedMotion) {
      reveals.forEach((element) => element.classList.add("is-visible"));
    } else {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const element = entry.target as HTMLElement;
            element.style.transitionDelay = element.style.getPropertyValue("--delay") || "0ms";
            element.classList.add("is-visible");
            revealObserver.unobserve(element);
          }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -6%" });
      reveals.forEach((element) => revealObserver.observe(element));
    }

    const modelButtons = document.querySelectorAll<HTMLButtonElement>("[data-model-view]");
    const modelCards = [...document.querySelectorAll<HTMLElement>("[data-model-card]")];
    modelButtons.forEach((button) => button.addEventListener("click", () => {
      const view = button.dataset.modelView;
      modelButtons.forEach((item) => {
        item.classList.toggle("is-active", item === button);
        item.setAttribute("aria-pressed", String(item === button));
      });
      modelCards.forEach((card) => card.hidden = false);
      const sorted = [...modelCards].sort((a, b) => {
        if (view === "capital") return Number(a.dataset.capital) - Number(b.dataset.capital);
        if (view === "flexible") {
          const aFlex = /remote|flexible/.test(a.dataset.tags || "") ? 1 : 0;
          const bFlex = /remote|flexible/.test(b.dataset.tags || "") ? 1 : 0;
          return bFlex - aFlex || Number(b.dataset.score) - Number(a.dataset.score);
        }
        return Number(b.dataset.score) - Number(a.dataset.score);
      });
      sorted.forEach((card, index) => {
        card.style.order = String(index);
        if (view === "physical") card.hidden = !(card.dataset.tags || "").includes("physical");
      });
    }));

    const fixedInput = document.querySelector<HTMLInputElement>("[data-fixed]");
    const marginInput = document.querySelector<HTMLInputElement>("[data-margin]");
    const ticketInput = document.querySelector<HTMLInputElement>("[data-ticket]");
    const currency = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
    const integer = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 });
    const updateEconomics = () => {
      if (!fixedInput || !marginInput || !ticketInput) return;
      const fixed = Number(fixedInput.value);
      const margin = Number(marginInput.value);
      const ticket = Number(ticketInput.value);
      const revenue = fixed / (margin / 100);
      const transactions = revenue / ticket;
      const set = (selector: string, value: string) => { const element = document.querySelector<HTMLElement>(selector); if (element) element.textContent = value; };
      set("[data-fixed-output]", currency.format(fixed));
      set("[data-margin-output]", `${margin}%`);
      set("[data-ticket-output]", currency.format(ticket));
      set("[data-revenue]", currency.format(revenue));
      set("[data-transactions]", integer.format(transactions));
      set("[data-daily]", integer.format(transactions / 30));
      set("[data-safe]", currency.format(revenue / .7));
    };
    [fixedInput, marginInput, ticketInput].forEach((input) => input?.addEventListener("input", updateEconomics));
    document.querySelectorAll<HTMLButtonElement>("[data-scenario]").forEach((button) => button.addEventListener("click", () => {
      const [fixed, margin, ticket] = (button.dataset.scenario || "").split(",");
      if (fixedInput) fixedInput.value = fixed;
      if (marginInput) marginInput.value = margin;
      if (ticketInput) ticketInput.value = ticket;
      document.querySelectorAll("[data-scenario]").forEach((item) => item.classList.toggle("is-active", item === button));
      updateEconomics();
    }));
    updateEconomics();
    languageToggle?.addEventListener("click", () => applyLanguage(language() === "zh" ? "en" : "zh"));
    applyLanguage(document.documentElement.lang === "zh-CN" ? "zh" : "en");
    if (window.location.hash) {
      requestAnimationFrame(() => document.querySelector(window.location.hash)?.scrollIntoView({ block: "start" }));
    }
  </script>
</BaseLayout>

